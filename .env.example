# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_platform

# Application Database URL (for NestJS in Phase 1)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/product_platform

# Redis URL (for caching in Phase 1)
# REDIS_URL=redis://redis:6379

# OpenSearch URL (for search in Phase 1)
# OPENSEARCH_URL=http://opensearch:9200

# JWT Secret (REQUIRED in production – generate with: openssl rand -hex 64)
JWT_SECRET=

# CORS Origins (comma-separated, defaults to localhost)
# CORS_ORIGINS=http://localhost:5173,http://localhost

# Node Environment
NODE_ENV=development
